# =============================================================================
# yume  --  the applications for this profile
# =============================================================================
#
# THE RULE FOR THIS FILE
#   Things you use as a person, on THIS desktop. If a different profile would
#   also want it on any machine, it belongs in modules/core/packages.nix
#   instead.
#
# WHY THESE ARE USER PACKAGES, NOT SYSTEM PACKAGES
#   Installing here means they land in your home profile: you can add one and
#   rebuild without touching the system closure, and a second user on this
#   machine does not silently inherit your application list.
# =============================================================================
{ self, inputs, pkgs, lib, ... }:
let
  # claude-code bypasses llm-agents entirely and overrides nixpkgs' OWN
  # claude-code package (pkgs/by-name/cl/claude-code) with a newer manifest.
  #
  # WHY: llm-agents.nix's `packages.<system>` output has to construct every
  # one of its ~190 tools just to build the filtered set it exposes (it
  # filters on `pkg.meta.broken`, which itself requires calling each
  # package) -- so ANY one broken tool in their repo poisons every package
  # they ship, claude-code included. As of writing their repo has a broken
  # package blocking this (git-surgeon, missing a required callPackage arg).
  #
  # nixpkgs' own claude-code package has no such problem: it is a single
  # self-contained fetchurl of one prebuilt binary from Anthropic's own CDN,
  # driven by a manifest.json (version + per-platform checksum). Overriding
  # just that manifest is enough to get a newer release without touching
  # anything else.
  #
  # TO UPDATE: curl -fsSL https://downloads.claude.ai/claude-code-releases/latest
  # gives the latest version string; then
  #   curl -fsSL https://downloads.claude.ai/claude-code-releases/<version>/manifest.json
  #     -o home/yume/pkgs/claude-code-manifest.json
  # replaces the pinned manifest below (this is the exact command nixpkgs'
  # own update.sh for this package uses, so the checksums are Anthropic's
  # official published ones, not something computed locally).
  claudeCode = pkgs.claude-code.override {
    manifest = lib.importJSON ./pkgs/claude-code-manifest.json;
  };

  # claude-desktop (the GUI app) is packaged by llm-agents, not nixpkgs itself
  # -- but its package.nix only needs ordinary nixpkgs libraries plus two
  # small custom setup hooks (codesignCheckHook, formatelf), none of which
  # touch llm-agents' broken shared package set. So rather than go through
  # `inputs.llm-agents.packages.<system>` (which forces-evaluates every tool
  # they ship, git-surgeon included, to build the filtered set it exposes --
  # see the comment on claudeCode above), this calls their package.nix files
  # directly, vendored locally in ./pkgs/.
  #
  # TO UPDATE: the three vendored package.nix files rarely change; what does
  # change is ./pkgs/claude-desktop/hashes.json (version + download URL +
  # hash per platform). Pull a fresh copy with:
  #   curl -fsSL https://raw.githubusercontent.com/numtide/llm-agents.nix/main/packages/claude-desktop/hashes.json \
  #     -o home/yume/pkgs/claude-desktop/hashes.json
  # (that file is generated by their own update.py from Anthropic's APT
  # index, so this is their published, official hash -- nothing computed
  # locally.) If their claude-desktop/package.nix itself has changed
  # meaningfully since, re-copy it the same way.
  claudeDesktop =
    let
      codesignCheckHook = pkgs.callPackage ./pkgs/codesignCheckHook/package.nix { };
      formatelf = pkgs.callPackage ./pkgs/formatelf/package.nix { };
    in
    pkgs.callPackage ./pkgs/claude-desktop/package.nix {
      flake = { inherit lib; };
      inherit codesignCheckHook formatelf;
    };
in
{
  home.packages = (with pkgs; [

    # --- browsers ---------------------------------------------------------
    # firefox is the default (Mod+B, and the handler for http/https below).
    #
    # Installed as a plain package rather than through `programs.firefox`,
    # deliberately: that module can manage profiles, and this profile is 1.6GB
    # of real history/logins living in ~/.config/mozilla. A plain package
    # install cannot write there at all.
    #
    # (Firefox 153+ follows the XDG base directory spec, which is why the
    # profile is in ~/.config/mozilla and not the older ~/.mozilla.)
    firefox
    google-chrome

    # --- terminals --------------------------------------------------------
    kitty          # the default, bound to Mod+T
    foot           # lightweight fallback; useful if kitty ever fails to start

    # --- files ------------------------------------------------------------
    kdePackages.dolphin   # graphical, bound to Mod+E
    yazi                  # terminal file manager
    file-roller           # archive extraction from the file manager

    # --- media ------------------------------------------------------------
    mpv
    jellyfin-desktop      # player for the Jellyfin library (modules/hosts/tuturu/jellyfin.nix)
    swayimg               # image viewer
    pwvucontrol           # audio mixer (PipeWire native)

    # --- gaming -------------------------------------------------------------
    # Epic Games Store / GOG / Amazon storefront client, plus a Wine/Proton
    # frontend for running Windows-only games -- the Linux equivalent of the
    # Epic/GOG launchers.
    heroic

    # Minecraft: Prism manages instances/mods/Java versions; Lunar Client is a
    # separate (unfree) pre-packaged client.
    # jdks: the Javas Prism can pick from per instance. 21 covers 1.20.5+;
    # 25 is for the newest releases. (Lunar Client ships its own Java, so
    # 1.8.9 there needs nothing here.)
    (prismlauncher.override { jdks = [ temurin-bin-21 temurin-bin-25 ]; })
    lunar-client

    # --- downloads ----------------------------------------------------------
    qbittorrent

    # --- wayland utilities ------------------------------------------------
    # These are what make copy/paste, screenshots and X11 apps work. They look
    # optional and are not.
    wl-clipboard          # clipboard access for command-line tools
    cliphist              # clipboard HISTORY, behind Mod+V
    xwayland-satellite    # runs X11-only apps under niri
    libnotify             # lets scripts send desktop notifications
    xdg-utils             # xdg-open, "open this file with the right app"

    # --- appearance -------------------------------------------------------
    matugen               # generates a colour scheme from your wallpaper
    adw-gtk3
    gsettings-desktop-schemas

    # --- shell tools ------------------------------------------------------
    atuin                 # searchable shell history
    grc                   # colourises command output
    imagemagick
  ])

  # --- AI tooling -----------------------------------------------------------
  ++ [
    claudeCode     # the CLI; see the `claudeCode` override above
    claudeDesktop  # the GUI app; see the `claudeDesktop` override above
  ]

  # --- iOS sideloading -----------------------------------------------------
  # Installs SideStore etc onto a connected iPhone/iPad. Packaged in
  # modules/features/ios-tools.nix (see that file for why it's not just a
  # flake input), which also enables the usbmuxd daemon it needs to actually
  # see the device.
  ++ [
    self.packages.${pkgs.stdenv.hostPlatform.system}.iloader
  ];
}

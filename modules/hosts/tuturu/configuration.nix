# =============================================================================
# tuturu  --  what is true about THIS physical machine
# =============================================================================
#
# Keep this file short. Anything that would also be true on another machine
# belongs in core/ (baseline) or a profile (desktop). What is left here is
# genuinely host-specific: its name, its hardware quirks, and the software you
# want on this box in particular.
# =============================================================================
{ self, inputs, ... }:
{
  flake.nixosModules.tuturuConfiguration =
    { pkgs, ... }:
    {
      imports = with self.nixosModules; [
        options            # the my.* settings, needed before anything reads them
        tuturuHardware     # generated by nixos-generate-config
        core               # the "it boots and works" baseline
      ];

      # --- who and what ------------------------------------------------------
      my.username = "delta";

      networking.hostName = "tuturu";

      # --- host-only software ------------------------------------------------
      # Everyday applications belong in home/yume/packages.nix. These two are
      # here because they come from flake inputs tied to this machine's setup.
      environment.systemPackages = [
        inputs.sidra.packages.${pkgs.stdenv.hostPlatform.system}.default
        inputs.antigravity-nix.packages.${pkgs.stdenv.hostPlatform.system}.google-antigravity-ide
      ];

      # --- the release this machine was installed at -------------------------
      # Same meaning as home.stateVersion (see home/yume/default.nix): it pins
      # DEFAULTS, not the NixOS version. Do not bump it to "upgrade" -- your
      # actual version comes from the nixpkgs input in flake.nix.
      system.stateVersion = "26.05";
    };
}
